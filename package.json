{
  "name": "pixel-eco",
  "private": true,
  "version": "1.5.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vitepress dev",
    "build": "vitepress build",
    "postbuild": "pagefind --site .vitepress/dist",
    "preview": "vitepress preview",
    "build:search": "npm run build && npm run preview",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:dev": "node scripts/verify-dev.mjs",
    "test:build": "node scripts/verify-build.mjs",
    "test:watch": "vitest"
  },
  "dependencies": {
    "vitepress-plugin-rss": "^0.4.4",
    "vue": "^3.5.18"
  },
  "devDependencies": {
    "@eslint/js": "^9.23.0",
    "@types/node": "^22.14.0",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.23.0",
    "eslint-plugin-vue": "^10.0.0",
    "globals": "^16.0.0",
    "gray-matter": "^4.0.3",
    "jsdom": "^26.0.0",
    "pagefind": "^1.5.2",
    "prettier": "^3.5.3",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.28.0",
    "vitepress": "^1.6.4",
    "vitest": "^3.0.9",
    "vue-tsc": "^2.2.8"
  }
}
